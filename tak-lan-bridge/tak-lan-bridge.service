[Unit]
Description=TAK LAN bridge (Mesh SA multicast <-> TAK server)
Wants=network-online.target wg-quick@wg0.service
After=network-online.target wg-quick@wg0.service

[Service]
Type=simple
User=tak-bridge
Group=tak-bridge
SupplementaryGroups=dialout
ExecStart=/opt/tak-lan-bridge/venv/bin/python -I /opt/tak-lan-bridge/tak_lan_bridge.py -c /etc/tak-lan-bridge/config.toml
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/tak-lan-bridge
# /var/lib/tak-lan-bridge, for [meshtastic] channels_file
StateDirectory=tak-lan-bridge

[Install]
WantedBy=multi-user.target
